{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-vitepress-notes",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-04",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "build": {
    "command": "npm run docs:build:site"
  },
  "assets": {
    "directory": "./docs/.vitepress/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://juzxailab.com",
    "ADMIN_EMAIL": "wo_sakura@163.com",
    "ACCESS_TEAM_DOMAIN": "https://wo-sakura.cloudflareaccess.com",
    "ACCESS_AUD": "dd8c890ba8cf86790fa4c508e9b0b575959ce7c0c8299690e62288abff5d012d"
  },
  "d1_databases": [
    {
      "binding": "PERSONAL_OS_DB",
      "database_name": "personal-os-config",
      "database_id": "6e539519-8dae-458f-b47e-367f9a7aef83",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": []
}
